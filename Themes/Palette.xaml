<!--
    Palette.xaml
    ==================================================================
    整套配色與字型從這裡出發，所有控制元件模板只引用這裡的畫刷，不再寫死顏色。
    色值直接從 MementoMori 的素材裡取樣：羊皮紙底色、墨綠進度條、
    水彩筆觸灰藍、按鈕圖示的赭石描邊。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 墨色：文字與描邊 ============ -->
    <Color x:Key="InkColor">#FF3E3A33</Color>
    <Color x:Key="InkSoftColor">#FF6E675C</Color>
    <Color x:Key="InkFaintColor">#FF9A9284</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}" />
    <SolidColorBrush x:Key="InkFaintBrush" Color="{StaticResource InkFaintColor}" />

    <!-- ============ 主色：水彩墨綠 ============ -->
    <Color x:Key="SageDeepColor">#FF3D6B5B</Color>
    <Color x:Key="SageColor">#FF5E8F7C</Color>
    <Color x:Key="SageMidColor">#FF7FAE9A</Color>
    <Color x:Key="SageSoftColor">#FFBFD8CB</Color>
    <Color x:Key="SageWashColor">#FFE8F1EB</Color>

    <SolidColorBrush x:Key="SageDeepBrush" Color="{StaticResource SageDeepColor}" />
    <SolidColorBrush x:Key="SageBrush" Color="{StaticResource SageColor}" />
    <SolidColorBrush x:Key="SageMidBrush" Color="{StaticResource SageMidColor}" />
    <SolidColorBrush x:Key="SageSoftBrush" Color="{StaticResource SageSoftColor}" />
    <SolidColorBrush x:Key="SageWashBrush" Color="{StaticResource SageWashColor}" />

    <!-- ============ 輔色：赭石 / 金 / 失敗紅 ============ -->
    <Color x:Key="ClayColor">#FFC07A5B</Color>
    <SolidColorBrush x:Key="ClayBrush" Color="{StaticResource ClayColor}" />
    <SolidColorBrush x:Key="ClayWashBrush" Color="#FFFAEDE6" />

    <Color x:Key="GoldColor">#FFBE9B54</Color>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldWashBrush" Color="#FFFBF2DE" />

    <Color x:Key="RoseColor">#FFB4544E</Color>
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}" />
    <SolidColorBrush x:Key="RoseWashBrush" Color="#FFF9EAE8" />

    <!-- ============ 紙面：卡片與分割線 ============ -->
    <SolidColorBrush x:Key="PaperBrush" Color="#FFF6F3EA" />
    <SolidColorBrush x:Key="CardBrush" Color="#E8FDFBF6" />
    <SolidColorBrush x:Key="CardQuietBrush" Color="#CCF4F1E7" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F2EFF7F0" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D2D5CBB4" />
    <SolidColorBrush x:Key="CardBorderSoftBrush" Color="#B3DFD7C4" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E4DCCAAE" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FFE7E2D6" />
    <SolidColorBrush x:Key="FieldBrush" Color="#F7FBF8F2" />

    <!-- ============ 字型 ============ -->
    <FontFamily x:Key="UiFont">Microsoft JhengHei UI, Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="DisplayFont">Georgia, Microsoft JhengHei UI, Microsoft YaHei UI, Segoe UI, serif</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- ============ 陰影 ============ -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="20" Direction="270"
                      ShadowDepth="3" Opacity="0.13" Color="#FF4A4237" />
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="10" Direction="270"
                      ShadowDepth="1" Opacity="0.16" Color="#FF4A4237" />
    <DropShadowEffect x:Key="PressShadow" BlurRadius="4" Direction="270"
                      ShadowDepth="1" Opacity="0.20" Color="#FF4A4237" />

</ResourceDictionary>
