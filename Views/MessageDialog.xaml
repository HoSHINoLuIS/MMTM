<Window x:Class="MementoMoriCodeRedeemer.Wpf.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="460"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        PreviewKeyDown="MessageDialog_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="26">
        <!-- 投影層單獨放，正文不參與 Effect 的離屏渲染 -->
        <Border CornerRadius="18" Background="{StaticResource CardBrush}" Effect="{StaticResource CardShadow}" />

        <Border x:Name="RootCard" CornerRadius="18" Background="#FCFAF4"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                Padding="24,20,24,18"
                MouseLeftButtonDown="RootCard_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 標題行 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="38" Height="38" VerticalAlignment="Top">
                        <Ellipse x:Name="IconCircle" Fill="{StaticResource SageWashBrush}" />
                        <TextBlock x:Name="IconGlyph" Text="!"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource SageDeepBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,-1,0,0" />
                    </Grid>

                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="標題"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap" />
                </Grid>

                <!-- 正文 -->
                <ScrollViewer Grid.Row="1" Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText" Style="{StaticResource MessageText}" Text="內容" />
                </ScrollViewer>

                <!-- 按鈕：走 PlainButton（WPF 原生外觀）。彈窗的按鈕不再裹遊戲水彩貼圖 —— 
                     斑駁的金／銀貼圖壓在乾淨的淺色卡片上太跳，跟這裡的整體觀感不搭。 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource PlainButton}"
                            MinWidth="88" Margin="0,0,10,0"
                            Click="CancelButton_Click" />
                    <Button x:Name="OkButton" Content="確定" Style="{StaticResource PlainButton}"
                            MinWidth="96" Click="OkButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
